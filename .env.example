# Copy this file to .env (or export these as real environment variables)
# before running the app.

# Required: your Anthropic API key, used by Strand 1 (SQL generation) and
# Strand 3 (summarization).
ANTHROPIC_API_KEY=sk-ant-...

# Postgres admin credentials (used only by db/seed.py to build the schema)
PG_HOST=localhost
PG_PORT=5432
PG_DB=finlytica_bank
PG_USER=postgres
PG_PASSWORD=finlytica123

# Postgres read-only credentials the NLQ engine itself connects with
# (created automatically by db/schema.sql -- don't need to change these
# unless you want different values).
PG_NLQ_USER=nlq_readonly
PG_NLQ_PASSWORD=nlq_readonly_pw
